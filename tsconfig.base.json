{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@xiaobai-amax/domain": ["packages/domain/src/index.ts"],
      "@xiaobai-amax/exercise-data": ["packages/exercise-data/src/index.ts"],
      "@xiaobai-amax/data-client": ["packages/data-client/src/index.ts"],
      "@xiaobai-amax/local-db": ["packages/local-db/src/index.ts"],
      "@xiaobai-amax/ui": ["packages/ui/src/index.ts"],
      "@xiaobai-amax/utils": ["packages/utils/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "scripts"],
  "exclude": ["apps/worker"]
}
